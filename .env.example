# =============================================================================
# DocuSage AI Platform — environment template
# Copy to .env and edit before production use:
#   cp .env.example .env
# =============================================================================

# --- Runtime mode ---
# development: allows sample secrets for local Docker
# production: refuses weak SECRET_KEY / sample DB password
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=docu_sage_db

# Backend async SQLAlchemy URL (must match Postgres credentials above)
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/docu_sage_db

# --- JWT / auth ---
# Replace with a long random string before production (openssl rand -hex 32)
SECRET_KEY=please-change-this-to-a-long-random-string-in-next-sprint
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated browser origins allowed to call the backend
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000

# Public URL of the frontend (used for password-reset email links)
PUBLIC_APP_URL=http://localhost:3000

# --- Optional SMTP (password reset emails). Leave SMTP_HOST empty to disable. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Backend ↔ AI unit ---
AI_SERVICE_URL=http://ai-service:8100
AI_SERVICE_TIMEOUT_SECONDS=180
AI_SERVICE_ENABLED=true
AI_FALLBACK_TO_EXTRACTIVE=true
AI_SUMMARIZE_MAX_ATTEMPTS=3
AI_SUMMARIZE_RETRY_SECONDS=1.5

# --- AI service / Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_PULL_ON_STARTUP=true
MAX_CONTEXT_CHARS=12000
MAX_SUMMARY_CHARS=4000

# --- Alembic / startup migrations ---
ENABLE_ALEMBIC_MIGRATIONS=true
ENABLE_CREATE_ALL_FALLBACK=true
DB_MIGRATION_MAX_RETRIES=5
DB_MIGRATION_RETRY_SECONDS=2
